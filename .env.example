# Base de datos Postgres (Neon). En Vercel se rellena sola al conectar Storage → Neon.
DATABASE_URL=

# Recomendado: secreto para firmar las sesiones (cualquier texto largo y aleatorio).
AUTH_SECRET=

# Celulares de los administradores, separados por comas. Si se deja vacío,
# la primera cuenta creada es la del administrador.
ADMIN_PHONES=

# Opcional: protege la ruta del cron (/api/cron). Vercel lo envía solo.
CRON_SECRET=

# Datos de pago y contacto que ve el cliente.
NEXT_PUBLIC_YAPE_PHONE=
NEXT_PUBLIC_PLIN_PHONE=
NEXT_PUBLIC_PAYMENT_HOLDER=
NEXT_PUBLIC_WHATSAPP=
